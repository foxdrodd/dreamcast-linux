From: Florian Fuchs <fuchsfl@gmail.com>
Date: Sat, 17 Oct 2026 13:00:00 +0200
Subject: [PATCH] pvr2fb: slide the boot screen out before taking over

When pvr2fb takes over, the BIOS licence screen ("Produced by or under
license from Sega") is still on display and simply vanishes when the
display is blanked for the VRAM clear.

Before blanking, read back the mode the bootloader left programmed
(start address, size, modulo, interlace) and move the display start
address down by an accelerating number of lines each frame, so the
image slides up and out of view over BOOTSCREEN_SLIDE_FRAMES frames,
while the border colour fades to black. The VRAM directly below the
image is cleared first, so black scrolls in from the bottom. Only
register writes are needed per frame, so this is cheap even on the
slow PVR bus.

Nothing happens when the display was not enabled or the mode reads
back as nonsense, and the slide stops if the scanline counter never
wraps (e.g. under emulators that do not model SPG_STATUS).

Signed-off-by: Florian Fuchs <fuchsfl@gmail.com>
---
diff --git a/drivers/video/fbdev/pvr2fb.c b/drivers/video/fbdev/pvr2fb.c
--- a/drivers/video/fbdev/pvr2fb.c
+++ b/drivers/video/fbdev/pvr2fb.c
@@ -94,6 +94,10 @@
 #define DISP_DIWHSTRT (DISP_BASE + 0xec)
 #define DISP_DIWVSTRT (DISP_BASE + 0xf0)
 #define DISP_PIXDEPTH (DISP_BASE + 0x108)
+#define DISP_SYNCSTAT (DISP_BASE + 0x10c)
+
+/* Frames the bootloader's screen takes to slide out at boot */
+#define BOOTSCREEN_SLIDE_FRAMES 30
 
 /* Pixel clocks, one for TV output, doubled for VGA output */
 #define TV_CLK 74239
@@ -776,6 +780,72 @@
 	return NULL;
 }
 
+/* Wait for the beam to wrap back to scanline 0, false on timeout */
+static bool pvr2_wait_vbl(struct pvr2fb_par *par)
+{
+	unsigned int timeout = 50000;
+
+	while (!(fb_readl(DISP_SYNCSTAT) & 0x1ff) && --timeout)
+		udelay(1);
+	while ((fb_readl(DISP_SYNCSTAT) & 0x1ff) && --timeout)
+		udelay(1);
+	return timeout;
+}
+
+static u32 pvr2_scale_rgb(u32 c, int num, int den)
+{
+	return ((((c >> 16) & 0xff) * num / den) << 16) |
+	       ((((c >> 8) & 0xff) * num / den) << 8) |
+	       ((c & 0xff) * num / den);
+}
+
+/*
+ * Slide the screen the bootloader left on display (the BIOS licence
+ * screen) up and out of view, fading its border colour to black, by
+ * moving the display start address down one step per frame.
+ */
+static void pvr2_slide_out_bootscreen(struct pvr2fb_par *par,
+				      void __iomem *vram, unsigned long vram_len)
+{
+	u32 size = fb_readl(DISP_DIWSIZE);
+	u32 border = fb_readl(DISP_BRDRCOLR);
+	u32 sof1 = fb_readl(DISP_DIWADDRL);
+	u32 sof2 = fb_readl(DISP_DIWADDRS);
+	unsigned long pitch, lines, start, end, off, i;
+	int f;
+
+	if (!(fb_readl(DISP_DIWMODE) & 1))
+		return;
+
+	/* second field address is only used when interlaced */
+	if (!(fb_readl(DISP_SYNCCONF) & 0x10))
+		sof2 = sof1;
+
+	pitch = ((size & 0x3ff) + ((size >> 20) & 0x3ff)) * 4;
+	lines = ((size >> 10) & 0x3ff) + 1;
+	start = min(sof1, sof2) & (vram_len - 1);
+	end = (max(sof1, sof2) & (vram_len - 1)) + pitch * lines;
+	if (end + pitch * lines > vram_len)
+		return;
+
+	/* black area below the image, which scrolls into view */
+	for (i = start + pitch * lines; i < end + pitch * lines; i += 4)
+		fb_writel(0, vram + i);
+
+	for (f = 1; f <= BOOTSCREEN_SLIDE_FRAMES; f++) {
+		/* accelerate upwards */
+		off = lines * f * f /
+		      (BOOTSCREEN_SLIDE_FRAMES * BOOTSCREEN_SLIDE_FRAMES) * pitch;
+		if (!pvr2_wait_vbl(par))
+			return;
+		fb_writel(sof1 + off, DISP_DIWADDRL);
+		fb_writel(sof2 + off, DISP_DIWADDRS);
+		fb_writel(pvr2_scale_rgb(border, BOOTSCREEN_SLIDE_FRAMES - f,
+					 BOOTSCREEN_SLIDE_FRAMES),
+			  DISP_BRDRCOLR);
+	}
+}
+
 /**
  * pvr2fb_common_init
  *
@@ -814,6 +884,8 @@
 		goto out_err;
 	}
 
+	pvr2_slide_out_bootscreen(par, fb_info->screen_base, pvr2_fix.smem_len);
+
 	/*
 	 * The display still scans out whatever the bootloader left set up.
 	 * Blank it with a black border until pvr2_init_display() takes over,
