From: Florian Fuchs <fuchsfl@gmail.com>
Date: Sat, 21 Nov 2026 21:45:00 +0100
Subject: [PATCH] fbdev: pvr2fb: Leave VRAM above the framebuffer to other users

On the Dreamcast pvr2fb claims all 8 MiB of PowerVR2 VRAM as smem_len:
it clears all of it at probe and lets userland mmap and write all of
it through /dev/fb0, although a 640x480 console needs 600 KiB (1.2 MiB
at 32 bpp). That leaves no safe room for the vramblk swap device, which
uses the 6 MiB above the first 2 MiB: anything writing the framebuffer
beyond that would silently corrupt swapped-out memory.

Add a "vram:<size>" option (video=pvr2fb:vram:2M) that sets how much
VRAM the framebuffer gets. It defaults to 2 MiB when vramblk is built
and to the old 8 MiB otherwise. Only that part is cleared and exported;
the boot screen pull-out still maps and uses all of VRAM, as it runs
before anything else touches it. Clearing 2 instead of 8 MiB also takes
a quarter of the time at probe.

The framebuffer part is claimed with request_mem_region(), and since
pvr2fb probes before vramblk, a vramblk window overlapping it (for
example with video=pvr2fb:vram:8M) now fails with -EBUSY instead of
sharing memory with the console.

---
diff --git a/drivers/video/fbdev/pvr2fb.c b/drivers/video/fbdev/pvr2fb.c
--- a/drivers/video/fbdev/pvr2fb.c
+++ b/drivers/video/fbdev/pvr2fb.c
@@ -58,6 +58,8 @@
 #include <linux/interrupt.h>
 #include <linux/fb.h>
 #include <linux/init.h>
+#include <linux/ioport.h>
+#include <linux/sizes.h>
 #include <linux/pci.h>
 
 #ifdef CONFIG_SH_DREAMCAST
@@ -184,6 +186,21 @@
 static int nopan = 0;
 static int nowrap = 1;
 
+/* All of the video memory, smem_len may only be a part of it */
+static unsigned long vram_total;
+
+#ifdef CONFIG_SH_DREAMCAST
+/*
+ * Video memory handed to the framebuffer on the Dreamcast; the rest of the
+ * 8 MiB stays untouched for other users such as the vramblk swap device,
+ * which starts 2 MiB into VRAM by default.  640x480 at 32 bpp needs 1.2 MiB.
+ * Override with video=pvr2fb:vram:<size>.
+ */
+static unsigned long vram_limit = IS_ENABLED(CONFIG_BLK_DEV_DC_VRAM) ?
+				  SZ_2M : SZ_8M;
+static struct resource *vram_res;
+#endif
+
 /*
  * We do all updating, blanking, etc. during the vertical retrace period
  */
@@ -992,8 +1009,11 @@
 	struct pvr2fb_par *par = currentpar;
 	unsigned long modememused, rev, i;
 
-	fb_info->screen_base = ioremap(pvr2_fix.smem_start,
-					       pvr2_fix.smem_len);
+	/*
+	 * Map all of VRAM: the boot screen can live anywhere in it.  Only
+	 * smem_len of it is the framebuffer that gets cleared and exported.
+	 */
+	fb_info->screen_base = ioremap(pvr2_fix.smem_start, vram_total);
 
 	if (!fb_info->screen_base) {
 		printk(KERN_ERR "pvr2fb: Failed to remap smem space\n");
@@ -1007,7 +1027,7 @@
 		goto out_err;
 	}
 
-	pvr2_pull_out_bootscreen(par, fb_info->screen_base, pvr2_fix.smem_len);
+	pvr2_pull_out_bootscreen(par, fb_info->screen_base, vram_total);
 
 	/*
 	 * The display still scans out whatever the bootloader left set up.
@@ -1017,7 +1037,10 @@
 	fb_writel(0, DISP_BRDRCOLR);
 	fb_writel(fb_readl(DISP_DIWCONF) | BLANK_BIT, DISP_DIWCONF);
 
-	/* VRAM does not take byte writes, so clear it a word at a time */
+	/*
+	 * VRAM does not take byte writes, so clear it a word at a time.  Only
+	 * the framebuffer part: the rest belongs to other users.
+	 */
 	for (i = 0; i < pvr2_fix.smem_len; i += 4)
 		fb_writel(0, fb_info->screen_base + i);
 
@@ -1125,7 +1148,9 @@
 	 * Nothing exciting about the DC PVR2 .. only a measly 8MiB.
 	 */
 	pvr2_fix.smem_start	= 0xa5000000;	/* RAM starts here */
-	pvr2_fix.smem_len	= 8 << 20;
+	vram_total		= SZ_8M;
+	pvr2_fix.smem_len	= clamp_t(unsigned long, PAGE_ALIGN(vram_limit),
+					  SZ_1M, SZ_8M);
 
 	pvr2_fix.mmio_start	= 0xa05f8000;	/* registers start here */
 	pvr2_fix.mmio_len	= 0x2000;
@@ -1142,6 +1167,16 @@
 	}
 #endif
 
+	/*
+	 * Claim the framebuffer part of VRAM (physical 0x05000000), so that
+	 * a driver set up to use the same memory (vramblk) fails to probe
+	 * instead of corrupting the console or being corrupted by it.
+	 */
+	vram_res = request_mem_region(0x05000000, pvr2_fix.smem_len, "pvr2fb");
+	if (!vram_res)
+		pr_warn("pvr2fb: VRAM 0-%uk is already in use\n",
+			pvr2_fix.smem_len >> 10);
+
 	return pvr2fb_common_init();
 }
 
@@ -1160,6 +1195,10 @@
 #ifdef CONFIG_PVR2_DMA
 	free_dma(pvr2dma);
 #endif
+	if (vram_res) {
+		release_mem_region(vram_res->start, resource_size(vram_res));
+		vram_res = NULL;
+	}
 }
 #endif /* CONFIG_SH_DREAMCAST */
 
@@ -1190,6 +1229,7 @@
 	 */
 	pvr2_fix.smem_start	= pci_resource_start(pdev, 0);
 	pvr2_fix.smem_len	= pci_resource_len(pdev, 0);
+	vram_total		= pvr2_fix.smem_len;
 
 	pvr2_fix.mmio_start	= pci_resource_start(pdev, 1);
 	pvr2_fix.mmio_len	= pci_resource_len(pdev, 1);
@@ -1243,6 +1283,8 @@
  *    inverse                             Use inverse color maps
  *    cable:composite|rgb|vga             Override the video cable type
  *    output:NTSC|PAL|VGA                 Override the video output format
+ *    vram:<size>                         Dreamcast: VRAM for the framebuffer
+ *                                        (default 2M with vramblk, else 8M)
  *
  *    <xres>x<yres>[-<bpp>][@<refresh>]   or,
  *    <name>[-<bpp>][@<refresh>]          Startup using this video mode
@@ -1273,6 +1315,10 @@
 			nopan = 1;
 		} else if (!strncmp(this_opt, "nowrap", 6)) {
 			nowrap = 1;
+#ifdef CONFIG_SH_DREAMCAST
+		} else if (!strncmp(this_opt, "vram:", 5)) {
+			vram_limit = memparse(this_opt + 5, NULL);
+#endif
 		} else {
 			mode_option = this_opt;
 		}
-- 
2.43.0
